#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

uniform uint uNumGroups;

layout(std430, binding = 5) readonly buffer HpartialBuf { float Hpartial[]; };
layout(std430, binding = 6) writeonly buffer HlevelBuf { float Hlevel[]; };

// 21 * 256 = 5376 floats
shared float sdata[21u * 256u];

void main()
{
    const uint workgroupSize = 256u;
    uint tid = gl_LocalInvocationID.x; // 0..255

    float H_local[21];
    for (uint i = 0u; i < 21u; ++i)
        H_local[i] = 0.0;

    // Each thread loads one or more partials (strided loading)
    uint idx = tid;
    while (idx < uNumGroups)
    {
        uint hBase = idx * 21u;
        for (uint i = 0u; i < 21u; ++i)
            H_local[i] += Hpartial[hBase + i];

        idx += workgroupSize;
    }

    // Write to shared memory: i*256 + tid
    for (uint i = 0u; i < 21u; ++i)
    sdata[i * workgroupSize + tid] = H_local[i];

    barrier();

    // Parallel reduction
    for (uint stride = workgroupSize >> 1u; stride > 0u; stride >>= 1u)
    {
        if (tid < stride)
        {
            for (uint i = 0u; i < 21u; ++i)
            sdata[i * workgroupSize + tid] += sdata[i * workgroupSize + tid + stride];
        }
        barrier();
    }

    // Thread 0 writes final result
    if (tid == 0u)
    {
        for (uint i = 0u; i < 21u; ++i)
        Hlevel[i] = sdata[i * workgroupSize + 0u];
    }
}