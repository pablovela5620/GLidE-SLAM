#version 310 es
precision highp float;
precision highp int;

// cap<=1000: one workgroup covers 256*4 = 1024 points => dispatch(1,1,1)
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

uniform uint uNPoints;

struct Chi2ValidData{float chi2;uint valid;};

// Inputs (per-point)
layout(std430, binding = 4) readonly buffer BBuffer    { vec4  B[];   } inB;
layout(std430, binding = 5) readonly buffer Chi2ValidBuffer  { Chi2ValidData data[]; } inChi2Valid;

// Outputs (single element; your ssbo_*Level buffers are sizeof(vec4/float/uint))
layout(std430, binding = 6) writeonly buffer BLevelBuffer    { vec4  B[];    }outBLevel;
layout(std430, binding = 7) writeonly buffer Chi2ValidLevelBuffer  { Chi2ValidData data[];  }outChi2ValidLevel;

shared vec4  sharedB0[256];
shared vec4  sharedB1[256];
shared float sharedChi2[256];
shared uint  sharedValid[256];

void main()
{
    const uint workgroupSize   = 256u;
    const uint pointsPerThread = 4u;

    uint threadID = gl_LocalInvocationID.x;
    uint gid      = gl_WorkGroupID.x;

    vec4  b0_local   = vec4(0.0);
    vec4  b1_local   = vec4(0.0);
    float chi2_local = 0.0;
    uint  valid_local = 0u;

    uint baseIdx = gid * workgroupSize * pointsPerThread + threadID * pointsPerThread;

    //this loop sums 4 points per threadID
    for (uint p = 0u; p < pointsPerThread; ++p)
    {
        uint ptIdx = baseIdx + p;
        if (ptIdx >= uNPoints) break;

        if (inChi2Valid.data[ptIdx].valid != 0u)
        {
            b0_local   += inB.B[ptIdx * 2u + 0u];
            b1_local   += inB.B[ptIdx * 2u + 1u];
            chi2_local += inChi2Valid.data[ptIdx].chi2;
            valid_local += 1u;
        }
    }

    sharedB0[threadID]   = b0_local;
    sharedB1[threadID]   = b1_local;
    sharedChi2[threadID] = chi2_local;
    sharedValid[threadID]= valid_local;

    barrier();

    // Parallel reduction (tree/binary reduction)
    // Sum as pairs, for 256 entries, total of 128 sums on first iteration, then 64 ... etc.
    //threadID = 0, workgroupsize = 256, stride = 128. sharedData [0] = sharedData[0] + sharedData[128]
    //threadID = 1, workgroupsize = 256, stride = 128. sharedData [1] = sharedData[1] + sharedData[129]
    //...
    //threadID = 127, workgroupsize = 256, stride = 128. sharedData [127] = sharedData[127] + sharedData[255]
    for (uint stride = workgroupSize >> 1u; stride > 0u; stride >>= 1u)
    {
        if (threadID < stride)
        {
            sharedB0[threadID]   += sharedB0[threadID + stride];
            sharedB1[threadID]   += sharedB1[threadID + stride];
            sharedChi2[threadID] += sharedChi2[threadID + stride];
            sharedValid[threadID]+= sharedValid[threadID + stride];
        }
        barrier();
    }

    if (threadID == 0u)
    {
        // gid is 0 for your current dispatch, but this stays correct if you later add more groups
        outBLevel.B[0] = sharedB0[0];
        outBLevel.B[1] = sharedB1[0];
        outChi2ValidLevel.data[0].chi2  = sharedChi2[0];
        outChi2ValidLevel.data[0].valid = sharedValid[0];
    }
}
